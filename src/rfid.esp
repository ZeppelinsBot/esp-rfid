int accountType;
int accountTypes[MAX_NUM_RELAYS];
String currentInput = "";
String pinCode = "";
String type = "";
String uid = "";
String v1uid = "";
String username = "";
String cardSecret = ""; // Secret read from chip before PICC_HaltA
bool wiegandAvailable = false;

// Auto-enroll: armed via WS "enroll" command, consumed when unknown card detected
volatile bool enrollPending = false;
volatile bool enrollRunning = false; // reentrancy guard (all MFRC522 ops in loop task)
enum RfidStates
{
	waitingRfid,
	cardSwiped,
	pinCodeEntered
};
enum RfidProcessingStates
{
	waitingProcessing,
	notValid,
	wrongPincode,
	expired,
	unknown,
	valid,
	validAdmin,
	cancelled
};

RfidStates rfidState = waitingRfid;
RfidProcessingStates processingState = waitingProcessing;

void loadWiegandData()
{
	wiegandAvailable = false;
	// wg.available checks if there's new info and populates all the internal data
	// so it should be called only once per loop
	wiegandAvailable = wg.available();
}

void rfidPrepareRead()
{
	if (config.readertype == READER_WIEGAND)
	{
		loadWiegandData();
	}
}

void wiegandRead()
{
	if (wiegandAvailable && rfidState == waitingRfid)
	{
		// if we get anything between 24 or 34 bit burst then we have a scanned PICC
		if (wg.getWiegandType() >= WIEGANDTYPE_PICC24 && wg.getWiegandType() <= WIEGANDTYPE_PICC34)
		{
			uid = String(wg.getCode(), config.wiegandReadHex ? HEX : DEC);
			type = String(wg.getWiegandType(), DEC);
#ifdef DEBUG
			Serial.print(F("[ INFO ] PICC's UID: "));
			Serial.println(uid);
#endif

			File f = SPIFFS.open("/P/" + uid, "r");
			// user exists, we should wait for pincode
			if (f)
			{
				size_t size = f.size();
				std::unique_ptr<char[]> buf(new char[size]);
				f.readBytes(buf.get(), size);
				f.close();
				JsonDocument json;
				auto error = deserializeJson(json, buf.get(), size);
				if (error)
				{
					processingState = notValid;
#ifdef DEBUG
					Serial.println("");
					Serial.println(F("[ WARN ] Failed to parse User Data"));
#endif
					return;
				}
				rfidState = cardSwiped;
				if (config.pinCodeRequested)
				{
					if(json["pincode"] == "")
					{
						rfidState = pinCodeEntered;
					} else
					{
						keyTimer = millis();
						ledWaitingOn();
					}
				}
			} else
			{
				cooldown = millis() + COOLDOWN_MILIS;
				rfidState = waitingRfid;
				processingState = unknown;
			}
		}
	}
}

MFRC522::MIFARE_Key defaultKey = {{0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF}};

// Harter Reset des MFRC522(-Clones) nach einem fehlgeschlagenen Auth:
// PCD_Reset+PCD_Init+AntennaOn bringen den Chip in einen sauberen Zustand
// (CommandReg-Idle allein reicht bei Clones nicht — sonst TIMEOUT-Kaskade).
// Danach Karte frisch per REQA selektieren (KEIN Halt/WUPA).
// Gibt true zurück, wenn die Karte nach dem Reset frisch selektiert wurde.
bool hardResetAndReselectCard() {
	mfrc522.PCD_Reset();
	delay(50);
	mfrc522.PCD_Init(rfidss, UINT8_MAX);
	mfrc522.PCD_AntennaOn();
	delay(100);
	// Frische REQA-Selektion (geduldiger Loop, wie im Enroll-Einstieg)
	unsigned long start = millis();
	while (millis() - start < 4000) {
		if (mfrc522.PICC_IsNewCardPresent() && mfrc522.PICC_ReadCardSerial()) {
			delay(100);
			return true;
		}
		delay(150);
	}
	return false;
}

// Sector 1, Block 4 — where we store the secret key
#define SECRET_SECTOR 1
#define SECRET_BLOCK  4
#define SECRET_KEY_LEN 16

// All 16 MIFARE Classic 1K sectors
#define NUM_MIFARE_SECTORS 16
// Sector trailer block numbers: 3, 7, 11, 15, 19, 23, 27, 31, 35, 39, 43, 47, 51, 55, 59, 63
static const byte SECTOR_TRAILER_BLOCKS[NUM_MIFARE_SECTORS] = {3, 7, 11, 15, 19, 23, 27, 31, 35, 39, 43, 47, 51, 55, 59, 63};

bool loadSectorMasterKey(MFRC522::MIFARE_Key &key)
{
	String keyString = config.sectorMasterKey ? String(config.sectorMasterKey) : "4B7EA39D1F58";
	if (keyString.length() != 12) return false;
	for (int i = 0; i < 6; i++)
	{
		char hex[3] = { keyString[i * 2], keyString[i * 2 + 1], 0 };
		char *end = nullptr;
		long value = strtol(hex, &end, 16);
		if (!end || *end != '\0' || value < 0 || value > 255) return false;
		key.keyByte[i] = (byte)value;
	}
	return true;
}

bool loadSectorMasterKeyString(const String &keyString, MFRC522::MIFARE_Key &key)
{
	if (keyString.length() != 12) return false;
	for (int i = 0; i < 6; i++)
	{
		char hex[3] = { keyString[i * 2], keyString[i * 2 + 1], 0 };
		char *end = nullptr;
		long value = strtol(hex, &end, 16);
		if (!end || *end != '\0' || value < 0 || value > 255) return false;
		key.keyByte[i] = (byte)value;
	}
	return true;
}

/*
 * Re-select a MIFARE Classic card after PICC_HaltA().
 * A halted card only responds to WUPA (not REQA), so PICC_IsNewCardPresent()
 * won't work. This helper sends WUPA, reads the serial, and gives the card
 * a moment to settle before returning.
 * Returns true if the card was successfully re-selected.
 */
bool reselectCard() {
	// Der RC522 (Clone, Version 0x92) braucht nach HLTA deutlich mehr
	// Vorlauf, bevor WUPA zuverlässig antwortet. Deshalb: lange Pause,
	// dann WUPA mit Retries, dann Selektion mit kurzer Settle-Pause.
	delay(300);
	mfrc522.PICC_HaltA();
	delay(300);
	byte bufferATQA[2];
	byte bufferSize = 2;
	bool found = false;
	for (int i = 0; i < 5 && !found; i++) {
		if (mfrc522.PICC_WakeupA(bufferATQA, &bufferSize) == MFRC522::STATUS_OK) {
			found = true;
		} else {
			delay(150);
		}
	}
	if (!found) return false;
	if (!mfrc522.PICC_ReadCardSerial()) {
		// Einmal wiederholen nach kurzer Pause
		delay(100);
		if (!mfrc522.PICC_ReadCardSerial()) return false;
	}
	delay(200);
	return true;
}

/**
 * Warm-up: Der erste Crypto1-Auth direkt nach der Selektion failt bei
 * RC522-Clones (Status 1). Einmal blind authentifizieren, Session sofort
 * beenden — der folgende "echte" Auth ist dann zuverlässig.
 */
void warmUpAuth() {
	mfrc522.PCD_StopCrypto1();
	MFRC522::MIFARE_Key k;
	memcpy(k.keyByte, defaultKey.keyByte, 6);
	mfrc522.PCD_Authenticate(MFRC522::PICC_CMD_MF_AUTH_KEY_A, SECRET_BLOCK, &k, &(mfrc522.uid));
	mfrc522.PCD_StopCrypto1();
	delay(50);
}

/*
 * Lock ALL 16 MIFARE Classic 1K sector trailers with the custom master key.
 * NO halt/re-detect between sectors — keeps the crypto session alive
 * throughout. The caller must have an active crypto session (e.g. after
 * secret write + verify in enrollMifareClassic).
 * For each sector trailer: authenticates with master key (fallback default key),
 * reads current data, replaces Key A and Key B with master key, keeps access
 * bits (bytes 6-9), writes back. Max 3 attempts per sector.
 * At the end: PCD_StopCrypto1 + PICC_HaltA + delay.
 * Returns true if all sectors were successfully locked.
 */
bool lockAllSectors()
{
	Serial.println(F("[LOCK] Locking all 16 sector trailers with master key..."));

	MFRC522::MIFARE_Key masterKey;
	if (!loadSectorMasterKey(masterKey))
	{
		Serial.println(F("[LOCK] Aborted: invalid sector master key in config"));
		mfrc522.PCD_StopCrypto1();
		mfrc522.PICC_HaltA();
		return false;
	}

	// Die Karte ist von enrollMifareClassic() noch selektiert und UNGEHALTED.
	// Auf diesem RC522-Clone muss die Karte IMMER selektiert bleiben —
	// HaltA/WUPA führen zuverlässig zu STATUS_TIMEOUT.
	// Nur die Crypto-Session beenden, dann direkt loslegen.
	mfrc522.PCD_StopCrypto1();
	delay(100);

	bool allOk = true;
	for (int sec = 0; sec < NUM_MIFARE_SECTORS; sec++)
	{
		const byte trailer = SECTOR_TRAILER_BLOCKS[sec];
		bool locked = false;

		for (int attempt = 0; attempt < 3 && !locked; attempt++)
		{
			// Saubere Crypto-Session vor jedem Auth-Versuch
			mfrc522.PCD_StopCrypto1();
			delay(50);

			// Reihenfolge: Default-Key ZUERST (frische Karten haben FF-Keys),
			// Master-Key als Fallback. Grund: Ein fehlgeschlagener MFAuthent
			// auf dem RC522-Clone vergiftet den Transceiver -> STATUS_TIMEOUT(3)
			// fuer alle Folge-Auths. Default-Key vermeidet den Fehlversuch auf
			// frischen Karten komplett.
			bool authed = false;
			MFRC522::StatusCode status;

			// 1) Default-Key zuerst
			MFRC522::MIFARE_Key defKey;
			memcpy(defKey.keyByte, defaultKey.keyByte, 6);
			status = mfrc522.PCD_Authenticate(
				MFRC522::PICC_CMD_MF_AUTH_KEY_A, trailer, &defKey, &(mfrc522.uid));
			if (status == MFRC522::STATUS_OK)
			{
				authed = true;
			#ifdef DEBUG
				Serial.printf("[LOCK] Sector %d: authenticated with default key\n", sec);
			#endif
			}
			else
			{
				// Harter Reset nach fehlgeschlagenem Default-Auth:
				// CommandReg-Idle reicht bei Clones nicht -> PCD_Reset+Init+AntennaOn
				Serial.printf("[LOCK] Sector %d: default key failed — hard resetting reader\n", sec);
				if (!hardResetAndReselectCard()) {
					Serial.printf("[LOCK] Sector %d: card lost after reader reset\n", sec);
					continue;
				}

				// 2) Master-Key als Fallback
				status = mfrc522.PCD_Authenticate(
					MFRC522::PICC_CMD_MF_AUTH_KEY_A, trailer, &masterKey, &(mfrc522.uid));
				if (status == MFRC522::STATUS_OK)
				{
					authed = true;
				#ifdef DEBUG
					Serial.printf("[LOCK] Sector %d: authenticated with master key\n", sec);
				#endif
				}
			}

			if (!authed)
			{
				// Harter Reset nach komplett fehlgeschlagenem Auth (beide Keys)
				if (!hardResetAndReselectCard()) {
					Serial.printf("[LOCK] Sector %d: card lost after reader reset\n", sec);
				}
				Serial.printf("[LOCK] Sector %d attempt %d: auth failed status=%d\n", sec, attempt + 1, status);
				continue;
			}

			// Aktuellen Trailer lesen
			byte trailerData[18]; byte trailerSize = 18;
			status = mfrc522.MIFARE_Read(trailer, trailerData, &trailerSize);
			if (status != MFRC522::STATUS_OK)
			{
				Serial.printf("[LOCK] Sector %d attempt %d: trailer read failed status=%d\n", sec, attempt + 1, status);
				continue;
			}

			// Key A (Bytes 0-5) und Key B (Bytes 10-15) ersetzen, Access-Bits (Bytes 6-9) behalten
			memcpy(trailerData, masterKey.keyByte, 6);
			memcpy(trailerData + 10, masterKey.keyByte, 6);

			status = mfrc522.MIFARE_Write(trailer, trailerData, 16);
			// Crypto-Session IMMER beenden nach Write (egal ob ok oder nicht)
			mfrc522.PCD_StopCrypto1();
			if (status != MFRC522::STATUS_OK)
			{
				Serial.printf("[LOCK] Sector %d attempt %d: trailer write failed status=%d\n", sec, attempt + 1, status);
				continue;
			}

			Serial.printf("[LOCK] Sector %d: OK\n", sec);
			locked = true;
		}

		if (!locked)
		{
			Serial.printf("[LOCK] Sector %d: FAILED after 3 attempts\n", sec);
			allOk = false;
		}
	}

	// Aufräumen nach allen Sektoren: Crypto beenden, Karte einmalig halten
	mfrc522.PCD_StopCrypto1();
	mfrc522.PICC_HaltA();
	delay(200);

	if (allOk)
		Serial.println(F("[LOCK] SUCCESS: all 16 sectors locked with master key"));
	else
		Serial.println(F("[LOCK] PARTIAL: some sectors could not be locked"));
	return allOk;
}

bool migrateMifareSector(const String &oldKeyString, const String &newKeyString)
{
	Serial.printf("[MIGRATE] Starting sector key migration old=%s new=%s\n", oldKeyString.c_str(), newKeyString.c_str());
	if (oldKeyString == newKeyString)
	{
		Serial.println(F("[MIGRATE] Aborted: old and new keys are identical"));
		return false;
	}
	MFRC522::MIFARE_Key oldKey, newKey;
	if (!loadSectorMasterKeyString(oldKeyString, oldKey) || !loadSectorMasterKeyString(newKeyString, newKey))
	{
		Serial.println(F("[MIGRATE] Aborted: keys must contain exactly 12 hexadecimal characters"));
		return false;
	}
	Serial.println(F("[MIGRATE] Present card and hold for 5 seconds..."));
	unsigned long start = millis();
	while (millis() - start < 15000 && (!mfrc522.PICC_IsNewCardPresent() || !mfrc522.PICC_ReadCardSerial())) delay(50);
	if (!mfrc522.uid.size)
	{
		Serial.println(F("[MIGRATE] Failed: no card detected within 15 seconds"));
		return false;
	}
	Serial.print(F("[MIGRATE] Card detected UID="));
	for (byte i = 0; i < mfrc522.uid.size; i++) Serial.printf("%02X", mfrc522.uid.uidByte[i]);
	Serial.println();

	bool allOk = true;
	for (int sec = 0; sec < NUM_MIFARE_SECTORS; sec++)
	{
		const byte trailer = SECTOR_TRAILER_BLOCKS[sec];
		bool locked = false;

		for (int attempt = 0; attempt < 3 && !locked; attempt++)
		{
			// Halt + re-detect before each attempt to ensure clean crypto state
			if (attempt > 0)
			{
				mfrc522.PCD_StopCrypto1();
				mfrc522.PICC_HaltA();
				if (!reselectCard())
				{
					Serial.printf("[MIGRATE] Sector %d attempt %d: card lost during re-detect\n", sec, attempt + 1);
					continue;
				}
			}

			// Try authenticating with old key
			MFRC522::StatusCode status = mfrc522.PCD_Authenticate(MFRC522::PICC_CMD_MF_AUTH_KEY_A, trailer, &oldKey, &(mfrc522.uid));
			if (status != MFRC522::STATUS_OK)
			{
				Serial.printf("[MIGRATE] Sector %d attempt %d: old key auth failed status=%d\n", sec, attempt + 1, status);
				continue;
			}

			byte trailerData[18]; byte trailerSize = 18;
			status = mfrc522.MIFARE_Read(trailer, trailerData, &trailerSize);
			if (status != MFRC522::STATUS_OK)
			{
				Serial.printf("[MIGRATE] Sector %d attempt %d: trailer read failed status=%d\n", sec, attempt + 1, status);
				continue;
			}

			memcpy(trailerData, newKey.keyByte, 6);
			memcpy(trailerData + 10, newKey.keyByte, 6);
			status = mfrc522.MIFARE_Write(trailer, trailerData, 16);
			if (status != MFRC522::STATUS_OK)
			{
				Serial.printf("[MIGRATE] Sector %d attempt %d: trailer write failed status=%d\n", sec, attempt + 1, status);
				continue;
			}

			Serial.printf("[MIGRATE] Sector %d: migrated OK\n", sec);
			locked = true;

			// Halt after each successful migration to reset crypto state for next sector
			mfrc522.PCD_StopCrypto1();
			mfrc522.PICC_HaltA();
			delay(100);
		}

		if (!locked)
		{
			Serial.printf("[MIGRATE] Sector %d: FAILED after 3 attempts\n", sec);
			allOk = false;
			mfrc522.PCD_StopCrypto1();
			mfrc522.PICC_HaltA();
		}
		else if (sec < NUM_MIFARE_SECTORS - 1)
		{
			// Re-detect with WUPA — card was halted after successful migration
			if (!reselectCard())
			{
				Serial.printf("[MIGRATE] Card lost after sector %d, cannot continue\n", sec);
				allOk = false;
				break;
			}
		}
	}

	mfrc522.PCD_StopCrypto1(); mfrc522.PICC_HaltA();
	if (allOk)
		Serial.println(F("[MIGRATE] SUCCESS: all sectors migrated. Secret unchanged. Update config key before next door access."));
	else
		Serial.println(F("[MIGRATE] PARTIAL: some sectors could not be migrated"));
	return allOk;
}

/*
 * Reset ALL MIFARE Classic 1K sector trailers back to factory defaults.
 * Authenticates each sector trailer with the master key before writing.
 * Returns true if all sectors were successfully formatted.
 */
bool formatMifareCard() {
	Serial.println(F("[FORMAT] Waiting for card..."));
	unsigned long start = millis();
	while (millis() - start < 10000) {
		if (mfrc522.PICC_IsNewCardPresent() && mfrc522.PICC_ReadCardSerial()) {
			break;
		}
		delay(50);
	}
	if (!mfrc522.uid.size) {
		Serial.println(F("[FORMAT] Timeout — no card found"));
		return false;
	}

	// Set global uid
	uid = "";
	for (byte i = 0; i < mfrc522.uid.size; i++) {
		if (mfrc522.uid.uidByte[i] < 0x10) uid += "0";
		uid += String(mfrc522.uid.uidByte[i], HEX);
	}
	uid.toLowerCase();
	Serial.printf("[FORMAT] Card UID: %s\n", uid.c_str());
	delay(100);

	// Load the configured master key for authentication
	MFRC522::MIFARE_Key key;
	if (!loadSectorMasterKey(key)) {
		Serial.println(F("[FORMAT] Invalid sector master key in config"));
		mfrc522.PCD_StopCrypto1();
		mfrc522.PICC_HaltA();
		return false;
	}

	// Factory default MIFARE Classic sector trailer:
	// Key A: FF FF FF FF FF FF
	// Access bits: FF 07 80 69
	// Key B: FF FF FF FF FF FF
	byte factoryTrailer[16] = {
		0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,  // Key A (factory default)
		0xFF, 0x07, 0x80, 0x69,               // Access bits
		0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF   // Key B (factory default)
	};

	bool allOk = true;
	for (int sec = 0; sec < NUM_MIFARE_SECTORS; sec++)
	{
		const byte trailer = SECTOR_TRAILER_BLOCKS[sec];
		bool formatted = false;

		for (int attempt = 0; attempt < 3 && !formatted; attempt++)
		{
			// Halt + re-detect before retry to ensure clean crypto state
			if (attempt > 0)
			{
				mfrc522.PCD_StopCrypto1();
				mfrc522.PICC_HaltA();
				if (!reselectCard())
				{
					Serial.printf("[FORMAT] Sector %d attempt %d: card lost\n", sec, attempt + 1);
					continue;
				}
			}

			// Try master key, fall back to default key
			MFRC522::StatusCode status = mfrc522.PCD_Authenticate(
				MFRC522::PICC_CMD_MF_AUTH_KEY_A, trailer, &key, &(mfrc522.uid));
			if (status != MFRC522::STATUS_OK)
			{
				// Retry with default key
				MFRC522::MIFARE_Key defKey;
				memcpy(defKey.keyByte, defaultKey.keyByte, 6);
				status = mfrc522.PCD_Authenticate(
					MFRC522::PICC_CMD_MF_AUTH_KEY_A, trailer, &defKey, &(mfrc522.uid));
			}
			if (status != MFRC522::STATUS_OK)
			{
				Serial.printf("[FORMAT] Sector %d attempt %d: auth failed status=%d\n", sec, attempt + 1, status);
				continue;
			}

			status = mfrc522.MIFARE_Write(trailer, factoryTrailer, 16);
			if (status != MFRC522::STATUS_OK)
			{
				Serial.printf("[FORMAT] Sector %d attempt %d: write failed status=%d\n", sec, attempt + 1, status);
				continue;
			}

			Serial.printf("[FORMAT] Sector %d: formatted OK\n", sec);
			formatted = true;

			// Halt after each successful format to reset crypto state
			mfrc522.PCD_StopCrypto1();
			mfrc522.PICC_HaltA();
			delay(100);
		}

		if (!formatted)
		{
			Serial.printf("[FORMAT] Sector %d: FAILED after 3 attempts\n", sec);
			allOk = false;
			mfrc522.PCD_StopCrypto1();
			mfrc522.PICC_HaltA();
		}
		else if (sec < NUM_MIFARE_SECTORS - 1)
		{
			if (!reselectCard())
			{
				Serial.printf("[FORMAT] Card lost after sector %d\n", sec);
				allOk = false;
				break;
			}
		}
	}

	// Verify: try to authenticate with factory default key on Sector 1
	mfrc522.PCD_StopCrypto1();
	mfrc522.PICC_HaltA();
	if (reselectCard()) {
		MFRC522::MIFARE_Key defaultVerifyKey;
		memcpy(defaultVerifyKey.keyByte, defaultKey.keyByte, 6);
		MFRC522::StatusCode status = mfrc522.PCD_Authenticate(
			MFRC522::PICC_CMD_MF_AUTH_KEY_A, SECRET_BLOCK, &defaultVerifyKey, &(mfrc522.uid));
		if (status == MFRC522::STATUS_OK) {
			Serial.println(F("[FORMAT] Verify OK: Sector 1 restored to factory defaults."));
		} else {
			Serial.printf("[FORMAT] Verify auth failed: %d\n", status);
		}
	}

	mfrc522.PCD_StopCrypto1();
	mfrc522.PICC_HaltA();

	if (allOk)
		Serial.println(F("[FORMAT] SUCCESS: all 16 sectors restored to factory defaults."));
	else
		Serial.println(F("[FORMAT] PARTIAL: some sectors could not be formatted"));
	return allOk;
}

bool wipeMifareCard()
{
	Serial.println(F("[WIPE] Starting card wipe (format + remove user)..."));
	bool formatted = formatMifareCard();
	if (!formatted)
	{
		Serial.println(F("[WIPE] Failed: card formatting failed"));
		return false;
	}
	String filename = "/P/" + uid;
	if (SPIFFS.exists(filename))
	{
		SPIFFS.remove(filename);
		Serial.printf("[WIPE] SUCCESS: card formatted and user %s removed\n", uid.c_str());
	}
	else
	{
		Serial.printf("[WIPE] Card formatted, but no user file %s found\n", uid.c_str());
	}
	return true;
}

/*
 * Enroll a MIFARE Classic 1K chip by writing a random secret to Sector 1, Block 4.
 * The secret is then stored in the user JSON for later verification.
 * Returns true on success.
 */
bool enrollMifareClassic(String &outSecret, String &outSectorKey) {
	// Geduldige frische REQA-Selektion direkt vor der Auth: Der Loop-Scan
	// hat die Karte evtl. gerade selektiert (ACTIVE ignoriert REQA) — also
	// REQA wiederholt senden, bis sich die Karte (nach kurzer Ruhe in IDLE)
	// frisch fangen laesst. Exakt die Sequenz, die heute (11:05) als einzige
	// den Block-4-Auth durchbrachte. KEIN HaltA/WUPA (bricht den RC522-Clone).
	unsigned long reSelectStart = millis();
	bool reSelected = false;
	while (millis() - reSelectStart < 4000) {
		if (mfrc522.PICC_IsNewCardPresent() && mfrc522.PICC_ReadCardSerial()) {
			reSelected = true;
			break;
		}
		delay(150);
	}
	if (!reSelected) {
		Serial.println(F("[ENROLL] No card on reader"));
		return false;
	}
	mfrc522.PCD_StopCrypto1();
	delay(100);
	uid.toLowerCase();
	Serial.printf("[ENROLL] Card UID: %s\n", uid.c_str());

	// Warm-up: Clone braucht einen blinden Auth nach Selektion
	warmUpAuth();

	// Authenticate to Sector 1 with default Key A (with retries)
	MFRC522::MIFARE_Key key;
	memcpy(key.keyByte, defaultKey.keyByte, 6);
	MFRC522::StatusCode status;
	// Ensure clean crypto state before first auth attempt
	mfrc522.PCD_StopCrypto1();
	// Small delay to let the card settle after crypto reset (ESP32 RTOS needs this)
	delay(100);

	for (int attempt = 0; attempt < 3; attempt++) {
		status = mfrc522.PCD_Authenticate(
			MFRC522::PICC_CMD_MF_AUTH_KEY_A, SECRET_BLOCK, &key, &(mfrc522.uid));
		if (status == MFRC522::STATUS_OK) break;
		Serial.printf("[ENROLL] Auth attempt %d failed: %d\n", attempt + 1, status);
		if (attempt < 2) {
			Serial.printf("[ENROLL] Auth failed (status %d) — hard resetting reader\n", status);
			if (!hardResetAndReselectCard()) {
				Serial.println(F("[ENROLL] Card lost after reader reset"));
				return false;
			}
		}
	}
	if (status != MFRC522::STATUS_OK) {
		Serial.printf("[ENROLL] Auth failed after retries: %d\n", status);
		mfrc522.PCD_StopCrypto1();
		return false;
	}

	// Generate random 16-byte secret
	byte secretBuf[SECRET_KEY_LEN];
	for (int i = 0; i < SECRET_KEY_LEN; i++) {
		secretBuf[i] = esp_random() & 0xFF;
	}

	// Write secret to Block 4 (with retries)
	for (int attempt = 0; attempt < 3; attempt++) {
		status = mfrc522.MIFARE_Write(SECRET_BLOCK, secretBuf, SECRET_KEY_LEN);
		if (status == MFRC522::STATUS_OK) break;
		Serial.printf("[ENROLL] Write attempt %d failed: %d\n", attempt + 1, status);
		delay(100);
	}
	if (status != MFRC522::STATUS_OK) {
		Serial.printf("[ENROLL] Write failed after retries: %d\n", status);
		mfrc522.PCD_StopCrypto1();
		return false;
	}

	// Verify by reading back (with retries)
	byte readBuf[18];
	byte readSize = 18;
	bool verified = false;
	for (int attempt = 0; attempt < 3; attempt++) {
		readSize = 18;
		status = mfrc522.MIFARE_Read(SECRET_BLOCK, readBuf, &readSize);
		if (status == MFRC522::STATUS_OK && memcmp(readBuf, secretBuf, SECRET_KEY_LEN) == 0) {
			verified = true;
			break;
		}
		Serial.printf("[ENROLL] Verify attempt %d failed (status: %d)\n", attempt + 1, status);
		delay(100);
	}
	if (!verified) {
		Serial.println(F("[ENROLL] Verify failed after retries"));
		mfrc522.PCD_StopCrypto1();
		return false;
	}

	// Convert secret to hex string
	outSecret = "";
	for (int i = 0; i < SECRET_KEY_LEN; i++) {
		if (secretBuf[i] < 0x10) outSecret += "0";
		outSecret += String(secretBuf[i], HEX);
	}
	outSecret.toUpperCase();

	// --- Lock ALL sectors with master key ---
	if (!loadSectorMasterKey(key)) {
		Serial.println(F("[ENROLL] Invalid sector master key in config"));
		mfrc522.PCD_StopCrypto1();
		return false;
	}

	// Populate outSectorKey with the master key hex string
	outSectorKey = "";
	for (int i = 0; i < 6; i++) {
		if (key.keyByte[i] < 0x10) outSectorKey += "0";
		outSectorKey += String(key.keyByte[i], HEX);
	}
	outSectorKey.toUpperCase();

	bool allLocked = lockAllSectors();
	if (!allLocked) {
		Serial.println(F("[ENROLL] Warning: some sectors could not be locked"));
	}
	// lockAllSectors() does StopCrypto1 + HaltA + delay internally at the very end

	Serial.printf("[ENROLL] Success! Secret: %s SectorKey: %s\n", outSecret.c_str(), outSectorKey.c_str());
	return true;
}

/*
 * Verify a MIFARE Classic 1K chip by reading the secret from Sector 1, Block 4
 * and comparing it with the stored secret from the user JSON.
 * Returns true if the chip is genuine (secret matches).
 * Returns false if chip is cloned, empty, or not MIFARE Classic.
 */
bool verifyMifareClassic(const String &storedSecret) {
	if (storedSecret.length() == 0) {
		// No secret stored — legacy UID-only mode, skip verification
		return true;
	}

	// Use the secret already read in mfrc522Read() before PICC_HaltA
	if (cardSecret.length() == 0) {
		Serial.println(F("[VERIFY] No card secret available"));
		return false;
	}

	if (cardSecret == storedSecret) {
		Serial.println(F("[VERIFY] Secret matches — genuine chip"));
		return true;
	} else {
		Serial.printf("[VERIFY] Secret MISMATCH: card=%s stored=%s\n", cardSecret.c_str(), storedSecret.c_str());
		return false;
	}
}

void mfrc522Read()
{
	if (enrollRunning) return; // Guard: skip scan while enroll is active
	if (!mfrc522.PICC_IsNewCardPresent() || !mfrc522.PICC_ReadCardSerial())
	{
		return;
	}
	Serial.printf("[RFID] Card detected: ");
	for (byte i = 0; i < mfrc522.uid.size; i++) {
		Serial.printf("%02X", mfrc522.uid.uidByte[i]);
	}
	Serial.println();
	cardSecret = "";
	// Use master sector key to read the secret
	MFRC522::MIFARE_Key key;
	if (!loadSectorMasterKey(key)) {
		Serial.println(F("[RFID] Invalid sector master key in config"));
		mfrc522.PCD_StopCrypto1();
		mfrc522.PICC_HaltA();
		cooldown = millis() + COOLDOWN_MILIS;
		return;
	}

	// Read secret from Sector 1 BEFORE PICC_HaltA puts card to sleep
	{
		MFRC522::StatusCode st = mfrc522.PCD_Authenticate(
			MFRC522::PICC_CMD_MF_AUTH_KEY_A, SECRET_BLOCK, &key, &(mfrc522.uid));
		if (st == MFRC522::STATUS_OK) {
			byte readBuf[18];
			byte readSize = 18;
			st = mfrc522.MIFARE_Read(SECRET_BLOCK, readBuf, &readSize);
			if (st == MFRC522::STATUS_OK) {
				for (int i = 0; i < SECRET_KEY_LEN; i++) {
					if (readBuf[i] < 0x10) cardSecret += "0";
					cardSecret += String(readBuf[i], HEX);
				}
				cardSecret.toUpperCase();
			}
		} else {
			// Fallback: try default key for legacy cards (enrolled before sector key was changed)
			memcpy(key.keyByte, defaultKey.keyByte, 6);
			st = mfrc522.PCD_Authenticate(
				MFRC522::PICC_CMD_MF_AUTH_KEY_A, SECRET_BLOCK, &key, &(mfrc522.uid));
			if (st == MFRC522::STATUS_OK) {
				byte readBuf[18];
				byte readSize = 18;
				st = mfrc522.MIFARE_Read(SECRET_BLOCK, readBuf, &readSize);
				if (st == MFRC522::STATUS_OK) {
					for (int i = 0; i < SECRET_KEY_LEN; i++) {
						if (readBuf[i] < 0x10) cardSecret += "0";
						cardSecret += String(readBuf[i], HEX);
					}
					cardSecret.toUpperCase();
				}
			}
		}
	}
	mfrc522.PCD_StopCrypto1();

	/*
	 *  Convert RC522 UID into string
	 *  esp-rfid v1 had a bug where the UID string may miss some '0's. To
	 *  maintain compatibility, calculate incorrect UID here as well for
	 *  later checking in case old users exist in the config.
	 */
	uid = "";
	v1uid = "";
	for (byte i = 0; i < mfrc522.uid.size; i++) 
	{
		uid+=(String(mfrc522.uid.uidByte[i] < 0x10 ? "0" : ""));
		uid+=(String(mfrc522.uid.uidByte[i], HEX));
		v1uid+=(String(mfrc522.uid.uidByte[i], HEX));
	}

	MFRC522::PICC_Type piccType = mfrc522.PICC_GetType(mfrc522.uid.sak);
	type = mfrc522.PICC_GetTypeName(piccType);

#ifdef DEBUG
	Serial.print(F("[ INFO ] PICC's UID: "));
	Serial.print(uid);
	Serial.print(" " + type);
#endif

	// Check if user file exists — if NOT and auto-enroll is armed,
	// do the enroll NOW while the card is still SELECTED (not halted).
	// This avoids the reselectCard() problem that caused "No card on reader".
	String probeFile = "/P/" + uid;
	bool userExists = SPIFFS.exists(probeFile) || SPIFFS.exists("/P/" + v1uid);
	Serial.printf("[RFID] Checking %s exists...\n", probeFile.c_str());
	Serial.printf("[RFID] exists=%d\n", userExists ? 1 : 0);

	if (!userExists && enrollPending && !enrollRunning && config.readertype == READER_MFRC522) {
		enrollRunning = true;
		Serial.println(F("[ENROLL] Auto-enroll from fresh card detection (no halt/reselect needed)"));
		String sec, sKey;
		bool ok = enrollMifareClassic(sec, sKey);
		if (ok) {
			// Save user file with secret + auto-name
			String filename = "/P/" + String(uid);
			JsonDocument json;
			json["secret"] = sec;
			// Auto-name as neuerUserN
			int maxN = 0;
			File rootDir = SPIFFS.open("/P");
			if (rootDir && rootDir.isDirectory()) {
				File entry = rootDir.openNextFile();
				while (entry) {
					if (!entry.isDirectory()) {
						size_t esz = entry.size();
						std::unique_ptr<char[]> ebuf(new char[esz]);
						entry.readBytes(ebuf.get(), esz);
						JsonDocument ej;
						if (!deserializeJson(ej, ebuf.get(), esz)) {
							String uname = ej["user"].as<String>();
							if (uname.startsWith("neuerUser")) {
								int n = uname.substring(9).toInt();
								if (n > maxN) maxN = n;
							}
						}
					}
					entry = rootDir.openNextFile();
				}
			}
			json["user"] = "neuerUser" + String(maxN + 1);
			json["acctype"] = 0;
			json["validsince"] = 0;
			json["validuntil"] = 0;
			File f2 = SPIFFS.open(filename, "w");
			if (f2) {
				serializeJson(json, f2);
				f2.close();
			}
			Serial.printf("[ENROLL] Saved user neuerUser%d for UID %s\n", maxN + 1, uid.c_str());
			ws.textAll("[ENROLL] SUCCESS — Karte entfernen");
		} else {
			Serial.println(F("[ENROLL] Auto-enroll failed"));
			ws.textAll("{\"command\":\"result\",\"resultof\":\"enroll\",\"result\":false}");
		}
		enrollRunning = false;
		// lockAllSectors() already did PCD_StopCrypto1 + PICC_HaltA + delay
		cooldown = millis() + COOLDOWN_MILIS;
		return; // Card is halted, enrollment handled; skip normal flow
	}

	// Normal path: halt card, set state for rfidProcess()
	mfrc522.PICC_HaltA();
	cooldown = millis() + COOLDOWN_MILIS;
	rfidState = cardSwiped;
}

void pn532Read()
{
	bool found = false;
	byte pnuid[8] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
	eCardType e_CardType;
	byte u8_UidLength = 0x00; // UID = 4 or 7 bytes
	found = pn532.ReadPassiveTargetID(pnuid, &u8_UidLength, &e_CardType);
	if (found && u8_UidLength >= 4)
	{
#ifdef DEBUG
		Serial.print(F("[ INFO ] PICC's UID: "));
#endif
		for (uint8_t i = 0; i < u8_UidLength; i++)
		{
			uid += String(pnuid[i], HEX);
			rfidState = cardSwiped;
		}
#ifdef DEBUG
		Serial.print(uid);
#endif
		cooldown = millis() + COOLDOWN_MILIS;
	}
}


/*
 *  Try first to read from RDM6300 hardware. If that received
 *  nothing, check the other configured reader.
 */
void genericRead()
{
	while (rdm6300HwSerial->available() > 0)
	{
		char read = rdm6300HwSerial->read();
		RFIDr.rfidSerial(read);
	}
	if (RFIDr.Available())
	{
		uid = RFIDr.GetHexID();
		type = RFIDr.GetTagType();
		rfidState = cardSwiped;
		cooldown = millis() + COOLDOWN_MILIS;
#ifdef DEBUG
		Serial.print(F("[ INFO ] PICC's UID: "));
		Serial.print(uid);
#endif
	}

	/*
	 *  If nothing read from the RDM6300, check the other hardware
	 */
	if (uid.length() == 0) {
		if (config.readertype == READER_MFRC522_RDM6300)
		{
			mfrc522Read();
		}

		else if (config.readertype == READER_WIEGAND_RDM6300)
		{
			wiegandRead();
		}

		else if (config.readertype == READER_PN532_RDM6300)
		{
			pn532Read();
		}
	}
}


/*
 *  Main function to read RFID cards. This function will call the
 *  correct reader function depending on the configured hardware,
 *  or otherwise call genericRead to read both RDM6300 and another
 *  configured reader.
 */
void rfidRead()
{
	/*
	 *  Do not try and read if we are already processing a card
	 */
	if (rfidState == cardSwiped)
	{
		return;
	}

	/*
	 *  Call the appropriate function based on the configured
	 *  hardware
	 */
	if (config.readertype == READER_MFRC522)
	{
		mfrc522Read();
	}

	else if (config.readertype == READER_WIEGAND)
	{
		wiegandRead();
	}

	else if (config.readertype == READER_PN532)
	{
		pn532Read();
	}

	else if (config.readertype > READER_PN532)
	{
		// This is a combination of RDM6300 and one of the above
		genericRead();
	}
}


/*
 *  Try and read a PIN code from Wiegand hardware
 */
void pinCodeRead()
{
	if (config.readertype != READER_WIEGAND ||
			!wiegandAvailable ||
			(!config.pinCodeRequested && rfidState == cardSwiped) ||
			(!config.pinCodeOnly && rfidState == waitingRfid) ||
			rfidState == pinCodeEntered)
	{
		return;
	}

	// if we get a 4 bit burst then a key has been pressed
	// add the key to the current input and reset the Waiting time
	// for the next key unless * or # have been pressed
	// we do not require * as the first character because some
	// readers use this as special admin code and would hence require *#PIN#
	if (wg.getWiegandType() == WIEGANDTYPE_KEYPRESS4 || wg.getWiegandType() == WIEGANDTYPE_KEYPRESS8)
	{
		if (wg.getCode() != WIEGAND_ENT && wg.getCode() != WIEGAND_ESC) // normal key entry, add to currentInput
		{
#ifdef DEBUG
			Serial.println("Keycode captured. . .");
#endif
			currentInput = currentInput + String(wg.getCode());
			keyTimer = millis();
			ledWaitingOn();
		} else if (keyTimer > 0) // if we are waitingProcessing on input still
		{
			if(wg.getCode() == WIEGAND_ESC) // esc, abort pincode
			{
#ifdef DEBUG
				Serial.println("Keycode escape, aborting pincode entry");
#endif
				rfidState = waitingRfid;
				processingState = cancelled;
				cooldown = millis() + COOLDOWN_MILIS;
			}
			if(wg.getCode() == WIEGAND_ENT) // enter, process pincode
			{
				pinCode = currentInput;
				if (config.pinCodeOnly && rfidState == waitingRfid)
				{
					uid = pinCode;
					rfidState = cardSwiped;
				} else
				{
					rfidState = pinCodeEntered;
				}
#ifdef DEBUG
				Serial.println("Stop capture keycode . . .");
				Serial.print(F("[ INFO ] PICC's pin code: "));
				Serial.println(currentInput);
#endif
				currentInput = "";
				keyTimer = 0;
				cooldown = millis() + COOLDOWN_MILIS;
			}
		}
	}
}

int weekdayFromMonday(int weekdayFromSunday) {
	// we expect weeks starting from Sunday equals to 1
	// we return week day starting from Monday equals to 0
	return ( weekdayFromSunday + 5 ) % 7;
}


/*
 *  If we have successfully read an RFID card, check if access
 *  should be granted
 */
void rfidProcess()
{
	if (rfidState == waitingRfid ||
			(config.pinCodeRequested && rfidState == cardSwiped))
	{
		return;
	}
	Serial.printf("[RFID] Processing: state=%d uid=%s\n", rfidState, uid.c_str());

	/* Each user has a file named after the RFID UID */
	String filename = "/P/" + uid;
	Serial.printf("[RFID] Checking %s exists...\n", filename.c_str());
	bool exists = SPIFFS.exists(filename);
	Serial.printf("[RFID] exists=%d\n", exists);
	File f = SPIFFS.open(filename, "r");
	Serial.println(f ? F("[RFID] File opened OK") : F("[RFID] File NOT found"));

	/*
	 *  If the file was not found then this is an unknown user, so no more
	 *  processing to be done. However, for backwards compatibility we do a
	 *  secondary check here to see if an old esp-rfid v1 uid exists and if
	 *  so use that.
	 */
	if (!exists)
	{
		/* Test to see if there was a uid in v1 format */
		bool existsV1 = SPIFFS.exists("/P/" + v1uid);
		if (!existsV1)
		{
			if (enrollRunning) {
				// Auto-enroll already ran from mfrc522Read() — card was just
				// enrolled and is halted. Don't re-process or send duplicate notification.
				return;
			}
			processingState = unknown;
			Serial.println(F("[RFID] Unknown user"));
			return;
		}
		uid = v1uid;
		Serial.printf("[RFID] Found v1 uid: %s\n", v1uid.c_str());
		// The first open was for the new UID and is invalid when only the
		// legacy UID file exists. Re-open the actual user file before reading it.
		f = SPIFFS.open("/P/" + uid, "r");
		if (!f)
		{
			processingState = unknown;
			Serial.println(F("[RFID] Legacy user file could not be opened"));
			return;
		}
	}

	/*
	 *  Read the user's settings
	 */
	size_t size = f.size();
	std::unique_ptr<char[]> buf(new char[size]);
	f.readBytes(buf.get(), size);
	f.close();
	JsonDocument json;
	auto error = deserializeJson(json, buf.get(), size);

	/*
	 *  Corrupt user data file, so return invalid user
	 */
	if (error)
	{
		processingState = notValid;
#ifdef DEBUG
		Serial.println("");
		Serial.println(F("[ WARN ] Failed to parse User Data"));
#endif
		return;
	}

	// if the pin code is wrong we deny access
	// pinCode is equal to uid if we allow pin code only access
	if(config.pinCodeRequested && pinCode != json["pincode"] && pinCode != uid && json["pincode"] != "")
	{
		processingState = wrongPincode;
#ifdef DEBUG
		Serial.println("Wrong pin code");
#endif
		return;
	}

	// Secret verification applies only to RC522/MIFARE cards. Wiegand,
	// PN532 and RDM6300 readers do not populate cardSecret.
	String storedSecret = json["secret"].as<String>();
	if (config.readertype == READER_MFRC522 &&
			storedSecret.length() > 0 && !verifyMifareClassic(storedSecret))
	{
		processingState = notValid;
		Serial.println(F("[RFID] Secret verification FAILED — cloned chip?"));
		return;
	}

	/*
	 *  Get account type (for FIRST relay only) and username from user's data
	 */
	accountType = json["acctype"];
	username = json["user"].as<String>();

#ifdef DEBUG
	Serial.println(" = known PICC");
	Serial.print("[ INFO ] User Name: '");
	if (username == "undefined")
		Serial.print(uid);
	else
		Serial.print(username);
	Serial.print("'");
#endif

	if (accountType == ACCESS_GRANTED)
	{
		/*
		 *  Normal user - relay but no admin access
		 */
		unsigned long validSinceL = json["validsince"];
		unsigned long validUntilL = json["validuntil"];
		unsigned long nowL = epoch;
		int hourTz = timeinfo.tm_hour;

		if (validUntilL < nowL || validSinceL > nowL)
		{
			processingState = expired;
		} else if (config.openingHours[weekdayFromMonday(weekday(epoch))][hourTz] != '1')
		{
			processingState = notValid;
		} else
		{
			processingState = valid;
		}
	} else if (accountType == ACCESS_ADMIN)
	{
		/*
		 *  Admin user - enable relay (with no time limits) and wifi
		 */
#ifdef DEBUG
		Serial.println(" has admin access, enable wifi");
#endif
		doEnableWifi = true;
		processingState = validAdmin;
	} else {
		/*
		 *  User exists but does not have access
		 */
		processingState = notValid;
	}

	/*
	 *  If user is valid and opening hour time is allowed, go through each relay
	 *  in turn to see if it needs to be activated
	 */
	if (processingState == valid || processingState == validAdmin)
	{
		for (int currentRelay = 0; currentRelay < config.numRelays; currentRelay++)
		{
			// Get user data JSON access type entry for this relay
			if (currentRelay == 0) {
				accountTypes[currentRelay] = json["acctype"];
			} else {
				accountTypes[currentRelay] = json["acctype" + String(currentRelay + 1)];
			}

			// Enable activation if permissions are correct
			activateRelay[currentRelay] = (accountTypes[currentRelay] == ACCESS_GRANTED);

			// ...except Admin, which always activates everything
			if (processingState == validAdmin)
			{
				activateRelay[currentRelay] = true;
			}
		}
	}
}

void rfidOutsideMessaging()
{
	if (processingState == valid)
	{
		ws.textAll("{\"command\":\"giveAccess\"}");
#ifdef DEBUG
		Serial.println(" has access relay");
#endif
		writeLatest(uid, username, accountType, ACCESS_GRANTED);
		if (config.numRelays == 1) {
			mqttPublishAccess(epoch, "true", "Always", username, uid, pinCode);
		} else {
			mqttPublishAccess(epoch, "true", accountTypes, username, uid, pinCode);
		}
		beeperValidAccess();
	}
	if (processingState == validAdmin)
	{
		ws.textAll("{\"command\":\"giveAccess\"}");
		writeLatest(uid, username, accountType, ACCESS_GRANTED);
		if (config.numRelays == 1) {
			mqttPublishAccess(epoch, "true", "Admin", username, uid, pinCode);
		} else {
			mqttPublishAccess(epoch, "true", accountTypes, username, uid, pinCode);
		}
		beeperAdminAccess();
	}
	if (processingState == expired)
	{
#ifdef DEBUG
		Serial.println(" expired");
#endif
		writeLatest(uid, username, accountType, ACCESS_DENIED);
		mqttPublishAccess(epoch, "true", "Expired", username, uid, pinCode);
		ledAccessDeniedOn();
		beeperAccessDenied();
	}
	if (processingState == wrongPincode)
	{
		writeLatest(uid, username, accountType, ACCESS_DENIED);
		mqttPublishAccess(epoch, "true", "Wrong pin code", username, uid, pinCode);
		ledAccessDeniedOn();
		beeperAccessDenied();
	}
	if (processingState == notValid)
	{
#ifdef DEBUG
		Serial.println(" does not have access");
#endif
		writeLatest(uid, username, accountType, ACCESS_DENIED);
		mqttPublishAccess(epoch, "true", "Disabled", username, uid, pinCode);
		ledAccessDeniedOn();
		beeperAccessDenied();
	}
	if (processingState == unknown)
	{
		String data = String(uid) += " " + String(type);
		writeEvent("WARN", "rfid", "Unknown rfid tag is scanned", data);
		writeLatest(uid, "Unknown", 98, ACCESS_DENIED);
		JsonDocument root;
		root["command"] = "piccscan";
		root["uid"] = uid;
		root["type"] = type;
		root["known"] = 0;
		size_t len = measureJson(root);
		AsyncWebSocketMessageBuffer *buffer = ws.makeBuffer(len + 1);
		if (buffer)
		{
			serializeJson(root, (char *)buffer->get(), len + 1);
			ws.textAll((const char *)buffer->get(), len);
		}
		mqttPublishAccess(epoch, "false", "Denied", "Unknown", uid, " ");
		ledAccessDeniedOn();
		beeperAccessDenied();
	} else if (uid != "" && processingState != waitingProcessing)
	{
		// message to the web UI to tell who has opened the door
		JsonDocument root;
		root["command"] = "piccscan";
		root["uid"] = uid;
		root["type"] = type;
		root["known"] = 1;
		root["acctype"] = accountType;
		root["user"] = username;
		size_t len = measureJson(root);
		AsyncWebSocketMessageBuffer *buffer = ws.makeBuffer(len + 1);
		if (buffer)
		{
			serializeJson(root, (char *)buffer->get(), len + 1);
			ws.textAll((const char *)buffer->get(), len);
		}
	}
}

void cleanRfidLoop()
{
	if (rfidState == waitingRfid)
	{
		delay(50);
	}
	// Keep an eye on timeout waitingProcessing for keypress
	// Clear code and timer when timeout is reached
	if ((keyTimer > 0 && millis() - keyTimer >= KEYBOARD_TIMEOUT_MILIS) || processingState != waitingProcessing)
	{
#ifdef DEBUG
		Serial.println("[ INFO ] Read timeout or clean after read");
#endif
		keyTimer = 0;
		currentInput = "";
		type = "";
		uid = "";
		v1uid = "";
		rfidState = waitingRfid;
		processingState = waitingProcessing;
		ledWaitingOff();
	}
}

void rfidLoop()
{
	rfidPrepareRead();
	rfidRead();
	pinCodeRead();
	rfidProcess();
	rfidOutsideMessaging();
	cleanRfidLoop();
}

#ifdef DEBUG
void ShowMFRC522ReaderDetails()
{
	// Get the MFRC522 software version
	byte v = mfrc522.PCD_ReadRegister(mfrc522.VersionReg);
	Serial.print(F("[ INFO ] MFRC522 Version: 0x"));
	Serial.print(v, HEX);
	if (v == 0x91)
		Serial.print(F(" = v1.0"));
	else if (v == 0x92)
		Serial.print(F(" = v2.0"));
	else if (v == 0x88)
		Serial.print(F(" = clone"));
	else
		Serial.print(F(" (unknown)"));
	Serial.println("");
	// When 0x00 or 0xFF is returned, communication probably failed
	if ((v == 0x00) || (v == 0xFF))
	{
		Serial.println(F("[ WARN ] Communication failure, check if MFRC522 properly connected"));
	}
}
#endif

void setupWiegandReader(int d0, int d1, bool removeParityBits)
{
	wg.begin(d0, d1);
	// Note: removeParityBits not supported by monkeyboard-org Wiegand lib
	// Parity stripping handled at read level if needed
	rfidState = waitingRfid;
}

// Custom SPI pins: SCK=GPIO4, MISO=GPIO5, MOSI=GPIO6
// GPIO8 (blue LED) stays free for relay indicator
#define MFRC522_SCK  4
#define MFRC522_MISO 5
#define MFRC522_MOSI 6

void setupMFRC522Reader(int rfidss, int rfidgain)
{
	Serial.printf("[ INFO ] MFRC522 init: SS=%u, Gain=%u\n", rfidss, rfidgain);
	SPI.begin(MFRC522_SCK, MFRC522_MISO, MFRC522_MOSI, rfidss);
	mfrc522.PCD_Init(rfidss, UINT8_MAX);
	mfrc522.PCD_SetAntennaGain(rfidgain);
	byte v = mfrc522.PCD_ReadRegister(mfrc522.VersionReg);
	Serial.printf("[ INFO ] MFRC522 Version: 0x%02X\n", v);
	if (v == 0x00 || v == 0xFF) {
		Serial.println(F("[ WARN ] MFRC522 communication failure — check wiring!"));
	} else {
		Serial.println(F("[ INFO ] MFRC522 ready"));
	}
}

void setupPN532Reader(int rfidss)
{
	// ESP32 C3 SPI pins for PN532 software SPI
	// SCK=GPIO4, MISO=GPIO5, MOSI=GPIO6, SS=rfidss, VSS=0
	pn532.InitSoftwareSPI(4, 5, 6, rfidss, 0);
	do
	{ // pseudo loop (just used for aborting with break;)
		// Reset the PN532
		pn532.begin(); // delay > 400 ms
		byte IC, VersionHi, VersionLo, Flags;
		if (!pn532.GetFirmwareVersion(&IC, &VersionHi, &VersionLo, &Flags))
			break;
#ifdef DEBUG
		char Buf[80];
		sprintf(Buf, "Chip: PN5%02X, Firmware version: %d.%d\r\n", IC, VersionHi, VersionLo);
		Utils::Print(Buf);
		sprintf(Buf, "Supports ISO 14443A:%s, ISO 14443B:%s, ISO 18092:%s\r\n", (Flags & 1) ? "Yes" : "No",
				(Flags & 2) ? "Yes" : "No",
				(Flags & 4) ? "Yes" : "No");
		Utils::Print(Buf);
#endif
		// Set the max number of retry attempts to read from a card.
		// This prevents us from waitingProcessing forever for a card, which is the default behaviour of the PN532.
		if (!pn532.SetPassiveActivationRetries())
		{
			break;
		}
		// configure the PN532 to read RFID tags
		if (!pn532.SamConfig())
		{
			break;
		}
	} while (false);
}

void setupRDM6300Reader(int rmd6300RxPin)
{
	// ESP32 C3 has hardware UART - use Serial1
	// Default: RX=GPIO20, TX=GPIO21
	rdm6300HwSerial = new HardwareSerial(1);
	rdm6300HwSerial->begin(RDM6300_BAUDRATE, SERIAL_8N1, rmd6300RxPin, -1);
	rdm6300HwSerial->setTimeout(RDM6300_READ_TIMEOUT);
}
