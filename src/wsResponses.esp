void sendUserList(int page, AsyncWebSocketClient *client)
{
	JsonDocument root;
	root["command"] = "userlist";
	root["page"] = page;
	JsonArray users = root["list"].to<JsonArray>();
	int first = (page - 1) * 10;
	int last = page * 10;
	int i = 0;

	// ESP32 SPIFFS directory iteration
	File rootDir = SPIFFS.open("/P/");
	if (!rootDir || !rootDir.isDirectory()) {
		root["haspages"] = 0;
		size_t len = measureJson(root);
		AsyncWebSocketMessageBuffer *buffer = ws.makeBuffer(len);
		if (buffer) {
			serializeJson(root, (char *)buffer->get(), len + 1);
			if (client) {
				client->text(buffer);
				client->text("{\"command\":\"result\",\"resultof\":\"userlist\",\"result\": true}");
			} else {
				ws.textAll("{\"command\":\"result\",\"resultof\":\"userlist\",\"result\": false}");
			}
		}
		return;
	}

	File file = rootDir.openNextFile();
	while (file)
	{
		String fileName = String(file.name());
		if (fileName.startsWith("/P/")) {
			if (i >= first && i < last)
			{
				JsonObject item = users.add<JsonObject>();
				String uid = fileName;
				uid.remove(0, 3);
				item["uid"] = uid;
				size_t size = file.size();
				std::unique_ptr<char[]> buf(new char[size]);
				file.readBytes(buf.get(), size);
				JsonDocument json;
				auto error = deserializeJson(json, buf.get(), size);
				if (!error)
				{
					String username = json["user"];
					String pincode = "";
					if(!json["pincode"].isNull())
					{
						pincode = String((const char *)json["pincode"]);
					}
					for (int x = 1; x <= MAX_NUM_RELAYS; x++)
					{
						String theKey = String();
						if (x == 1)
							theKey = "acctype";
						else
							theKey = "acctype" + String(x);
						int AccType = json[theKey];
						item[theKey] = AccType;
					}
					unsigned long validsince = !json["validsince"].isNull() ? json["validsince"] : 0;
					unsigned long validuntil = json["validuntil"];
					item["username"] = username;
					item["validsince"] = validsince;
					item["validuntil"] = validuntil;
					item["pincode"] = pincode;
				}
			}
			i++;
		}
		file = rootDir.openNextFile();
		yield();
	}
	rootDir.close();

	float pages = i / 10.0;
	root["haspages"] = ceil(pages);
	size_t len = measureJson(root);
	AsyncWebSocketMessageBuffer *buffer = ws.makeBuffer(len);
	if (buffer)
	{
		serializeJson(root, (char *)buffer->get(), len + 1);
		if (client)
		{
			// ESP32: use millis-based timer instead of Ticker
			AsyncWebSocketClient *capturedClient = client;
			wsTickerOnce(50, [capturedClient, buffer]() {
				capturedClient->text(buffer);
				capturedClient->text("{\"command\":\"result\",\"resultof\":\"userlist\",\"result\": true}");
			});
		}
		else
		{
			ws.textAll("{\"command\":\"result\",\"resultof\":\"userlist\",\"result\": false}");
		}
	}
}

void sendStatus(AsyncWebSocketClient *client)
{
	size_t spiffsTotal = SPIFFS.totalBytes();
	size_t spiffsUsed = SPIFFS.usedBytes();
	JsonDocument root;
	root["command"] = "status";
	root["heap"] = ESP.getFreeHeap();
	root["chipid"] = WiFi.macAddress();
	root["cpu"] = ESP.getCpuFreqMHz();
	root["sketchsize"] = ESP.getSketchSize();
	root["availsize"] = ESP.getFreeSketchSpace();
	root["availspiffs"] = spiffsTotal - spiffsUsed;
	root["spiffssize"] = spiffsTotal;

	int h = uptimeSeconds / 3600;
	int rem = uptimeSeconds % 3600;
	int m = rem / 60;
	int s = rem % 60;
	char uptimebuffer[9];
	sprintf(uptimebuffer, "%02d:%02d:%02d", h, m, s);
	root["uptime"] = uptimebuffer;

	root["version"] = VERSION;
	root["hostname"] = WiFi.getHostname();

	if (config.accessPointMode)
	{
		root["ssid"] = WiFi.softAPSSID();
		root["dns"] = printIP(WiFi.softAPIP());
		root["mac"] = WiFi.softAPmacAddress();
	}
	else
	{
		root["ssid"] = WiFi.SSID();
		root["dns"] = printIP(WiFi.dnsIP());
		root["mac"] = WiFi.macAddress();
	}

	root["ip"] = printIP(WiFi.localIP());
	root["gateway"] = printIP(WiFi.gatewayIP());
	root["netmask"] = printIP(WiFi.subnetMask());

	size_t len = measureJson(root);
	AsyncWebSocketMessageBuffer *buffer = ws.makeBuffer(len);
	if (buffer)
	{
		serializeJson(root, (char *)buffer->get(), len + 1);
		if (client)
		{
			client->text(buffer);
		}
		else
		{
			ws.textAll(buffer);
		}
	}
}

void printScanResult(int networksFound)
{
	// sort by RSSI
	int n = networksFound;
	int indices[n];
	int skip[n];
	for (int i = 0; i < networksFound; i++)
	{
		indices[i] = i;
	}
	for (int i = 0; i < networksFound; i++)
	{
		for (int j = i + 1; j < networksFound; j++)
		{
			if (WiFi.RSSI(indices[j]) > WiFi.RSSI(indices[i]))
			{
				std::swap(indices[i], indices[j]);
				std::swap(skip[i], skip[j]);
			}
		}
	}
	JsonDocument root;
	root["command"] = "ssidlist";
	JsonArray scan = root["list"].to<JsonArray>();
	for (int i = 0; i < 5 && i < networksFound; ++i)
	{
		JsonObject item = scan.add<JsonObject>();
		item["ssid"] = WiFi.SSID(indices[i]);
		item["bssid"] = WiFi.BSSIDstr(indices[i]);
		item["rssi"] = WiFi.RSSI(indices[i]);
		item["channel"] = WiFi.channel(indices[i]);
		item["enctype"] = WiFi.encryptionType(indices[i]);
		item["hidden"] = false; // ESP32: isHidden() not available, default false
	}
	size_t len = measureJson(root);
	AsyncWebSocketMessageBuffer *buffer = ws.makeBuffer(len);
	if (buffer)
	{
		serializeJson(root, (char *)buffer->get(), len + 1);
		ws.textAll(buffer);
	}
	WiFi.scanDelete();
}

void sendTime(AsyncWebSocketClient *client)
{
	JsonDocument root;
	root["command"] = "gettime";
	root["epoch"] = epoch;
	size_t len = measureJson(root);
	AsyncWebSocketMessageBuffer *buffer = ws.makeBuffer(len);
	if (buffer)
	{
		serializeJson(root, (char *)buffer->get(), len + 1);
		if (client)
		{
			client->text(buffer);
		}
		else
		{
			ws.textAll(buffer);
		}
	}
}
